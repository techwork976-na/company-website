# Copy this file to .env.local for local development, and add the same
# variables in your hosting provider (Vercel: Project Settings > Environment Variables).

# Resend API key, from https://resend.com/api-keys
RESEND_API_KEY=

# Inbox that receives new enquiries from the contact form.
CONTACT_TO_EMAIL=hello@betteflow.com

# Sender address for both emails. Its domain must be verified in Resend,
# for example: Betteflow <hello@betteflow.com>
CONTACT_FROM_EMAIL=

# Public URL of the site, without a trailing slash. Used for canonical URLs,
# the sitemap, robots.txt and social images.
NEXT_PUBLIC_SITE_URL=https://betteflow.com
